# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shortcutvid?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/shortcutvid?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth (Auth.js) — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret
AUTH_TRUST_HOST=true

# Encryption for OAuth tokens (32-byte hex): openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-64-char-hex-key

# OpenAI (required for script + TTS in Phase 1)
OPENAI_API_KEY=

# Optional: ElevenLabs TTS (falls back to OpenAI when unset)
ELEVENLABS_API_KEY=

# Pexels (required for stock footage)
PEXELS_API_KEY=

# Object storage (S3-compatible — MinIO in docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shortcutvid
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/shortcutvid
S3_FORCE_PATH_STYLE=true

# Local media fallback when S3 is not configured
LOCAL_STORAGE_PATH=./storage

# Stripe (Phase 2 — optional in Phase 1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# YouTube OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta / Instagram (Phase 3)
META_APP_ID=
META_APP_SECRET=

# LinkedIn (Phase 3)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Worker
WORKER_CONCURRENCY=2
VIDEO_RENDER_TIMEOUT_MS=600000

# Remotion
REMOTION_SERVE_URL=
